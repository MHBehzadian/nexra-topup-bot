BOT_TOKEN=
SUPERADMIN_IDS=123456789,987654321

NEXRA_PANEL_API_URL=https://your-panel-domain/dashboard
NEXRA_PANEL_BOT_API_KEY=change-me-must-match-nexra-panel-BOT_API_KEY

SQLITE_PATH=data/topup_bot.db
MEDIA_DIR=data/media

MIN_GB=200
MAX_GB=10000

# Management API for the Nexra panel (Bots → Top-up bot). 0 turns it off.
# The key defaults to NEXRA_PANEL_BOT_API_KEY, which the panel already holds.
MANAGEMENT_PORT=8090
MANAGEMENT_API_KEY=

# Sales bots made from «🤖 ربات‌های فروش» (installed over SSH, no domain needed).
# Optional: the Nexra Panel superadmin login, so each new bot joins the panel
# by itself (not needed when the panel runs on the same server as the bot).
NEXRA_PANEL_OWNER_USERNAME=
NEXRA_PANEL_OWNER_PASSWORD=
# Panel-management secret code for new bots (empty: a random one per bot).
NEXRA_SECRET_CODE=
# NEXRABOT_RELEASE=latest
